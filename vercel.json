{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(cart|checkout|login|account|admin)",
      "destination": "/200"
    },
    {
      "source": "/(order|review|account|admin)/:path*",
      "destination": "/200"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-jlkVcrOSn4aan5p/Wf9P2RYWEul/u0tCfT6jGBPLSss=' https://challenges.cloudflare.com https://www.googletagmanager.com https://sc-static.net https://tr.snapchat.com https://cdn.tamara.co https://eauthenticate.saudibusiness.gov.sa https://tap-sdks.b-cdn.net https://applepay.cdn-apple.com; style-src 'self' 'unsafe-inline' https://tap-sdks.b-cdn.net https://tap-assets.b-cdn.net; font-src 'self' https://cdn.tamara.co https://tap-sdks.b-cdn.net https://tap-assets.b-cdn.net; img-src 'self' data: blob: https:; connect-src 'self' https://dpjobithiiryniconytd.supabase.co wss://dpjobithiiryniconytd.supabase.co https://challenges.cloudflare.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://tr.snapchat.com https://*.snapchat.com https://*.tamara.co https://*.tap.company https://tap-sdks.b-cdn.net https://tap-assets.b-cdn.net; frame-src 'self' https://challenges.cloudflare.com https://tr.snapchat.com https://*.tamara.co https://eauthenticate.saudibusiness.gov.sa https://*.tap.company; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://*.tap.company; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(logo.png|logo-white.png|og.jpg|favicon.png|apple-touch-icon.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.rraed.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "api/_assets/**"
    }
  },
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "waarfe-store.vercel.app"
        }
      ],
      "destination": "https://rraed.com/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.rraed.com"
        }
      ],
      "destination": "https://rraed.com/$1",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "rraed.com"
        }
      ],
      "destination": "https://admin.rraed.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "rraed.com"
        }
      ],
      "destination": "https://admin.rraed.com/admin",
      "permanent": false
    },
    {
      "source": "/p/tmara-registration",
      "destination": "/tamara-registration",
      "permanent": true
    },
    {
      "source": "/p/issue-commercial-registration-saudi",
      "destination": "/commercial-registration",
      "permanent": true
    },
    {
      "source": "/p/freelance-certificate-family-platform",
      "destination": "/freelance-document",
      "permanent": true
    },
    {
      "source": "/p/ai-integration-chatgpt-claude-salla",
      "destination": "/salla-ai-integration",
      "permanent": true
    },
    {
      "source": "/p/(waarfe-ai-ad-campaigns-guide|ai-ad-campaigns-guide)",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/c/digital-products",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/c/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/p/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/:lang(ar|en|fr|it|de|es|tr|ur)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(ar|en|fr|it|de|es|tr|ur)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(ar|en|fr|it|de|es|tr|ur)/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/(privacy|terms|privacy\\.html|terms\\.html)",
      "destination": "/policies",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/(orders|orders\\.html)",
      "destination": "/account",
      "permanent": true
    }
  ]
}
